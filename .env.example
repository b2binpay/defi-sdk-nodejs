# B2BinPay DeFi API
API_BASE_URL="https://api.defi.b2binpay.com/"
AUTH_URL="https://defi.b2binpay.com/"
API_KEY="your-api-key"

# Blockchain
# The TRON examples read the same variables — point CHAIN_ID and RPC_URL at a TVM
# chain instead (728126428 + https://api.trongrid.io for TRON mainnet).
CHAIN_ID="1"
RPC_URL="https://eth.llamarpc.com"
WALLET_PRIVATE_KEY="your-64-char-hex-private-key"

# Payout example
PAYOUT_RECIPIENT="0xYourRecipientAddress"

# Optional
# PAYOUT_CURRENCY="USDT"
# POLL_INTERVAL_MS="5000"
# POLL_TIMEOUT_MS="300000"
