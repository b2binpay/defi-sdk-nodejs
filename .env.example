# Examples load this file through `dotenv/config`. Keep several environments side by side and pick one with
# DOTENV_CONFIG_PATH, e.g. `DOTENV_CONFIG_PATH=.env.nile npm run example:tron-full-flow`.

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the DeFi API
API_BASE_URL="https://api.defi.b2binpay.com/"

# API key for your account (create in Account -> Settings → API Keys)
API_KEY="ak_live_v1_..."

# ─── Chain ────────────────────────────────────────────────────────────────────
# Numeric chain ID. EVM: 11155111 Sepolia, 97 BSC Testnet, …
# TRON: 728126428 Mainnet, 3448148188 Nile (testnet, enabled on request)
CHAIN_ID="11155111"

# EVM: JSON-RPC endpoint. TRON: TronWeb full host, e.g. https://nile.trongrid.io
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Private key of the signer wallet (hex, 32 bytes, with or without 0x)
WALLET_PRIVATE_KEY=""

# Payout recipient for create-payout and the full-flow examples
PAYOUT_RECIPIENT="0x..."

# ─── Optional ─────────────────────────────────────────────────────────────────
# get-invoice-details: invoice to inspect (defaults to the newest one)
# INVOICE_ID=""
# claim-deposits / tron-claim-deposits: narrow the claimable list
# CLAIM_CURRENCY_ID=""
# CLAIM_INVOICE_ID=""
# CLAIM_PAGE_SIZE="50"
# tron-full-flow: payout currency symbol
# PAYOUT_CURRENCY="USDT"
# Polling for the flow examples
# POLL_INTERVAL_MS="5000"
# POLL_TIMEOUT_MS="300000"
